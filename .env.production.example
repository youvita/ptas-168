# Production compose env file.
# Copy to `.env.production` (gitignored) and fill in the secrets.
#
# Used by: infrastructure/docker/docker-compose.production.yml
# Scripts:  pnpm prod:build / prod:up / prod:down / prod:logs / etc.

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_DB=ptas168_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=           # REQUIRED — set a strong password
POSTGRES_PORT=5433           # host port (5433 avoids conflict with dev's 5432)

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=              # optional — leave blank for no auth
REDIS_PORT=6380              # host port (6380 avoids conflict with dev's 6379)

# ── Backend ───────────────────────────────────────────────────────────────
JWT_SECRET=                  # REQUIRED — min 32 characters
JWT_EXPIRES_IN=24h
BACKEND_PORT=3101            # host port (3101 avoids conflict with dev's 3001)
CORS_ORIGIN=https://ptas168.kilozin.xyz
API_BASE_PATH=/api
LOG_LEVEL=info

# ── Frontend ──────────────────────────────────────────────────────────────
FRONTEND_PORT=8180           # host port (8180 avoids conflict with dev's 8080)
VITE_API_URL=/api
VITE_FILE_URL=/files

# ── Telegram ──────────────────────────────────────────────────────────────
# Leave blank for stub mode (queue consumer runs, polling disabled).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BANK_BOT_TOKEN=

# ── Cloudflare R2 (file uploads) ─────────────────────────────────────────
# When R2_BUCKET + R2_PUBLIC_URL are set, uploads go to R2.
# Leave blank to use local disk (persisted in a Docker volume).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ── Misc ──────────────────────────────────────────────────────────────────
OVERDUE_CRON=0 9 * * *
FILE_URL_BASE=
