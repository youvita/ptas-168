{
  "name": "ptas168",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "pnpm --filter ptas168-backend dev",
    "dev:frontend": "pnpm --filter pbms-app dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.dev.yml up -d postgres redis",
    "db:down": "docker compose -f infrastructure/docker/docker-compose.dev.yml stop postgres redis",
    "db:logs": "docker compose -f infrastructure/docker/docker-compose.dev.yml logs -f postgres redis",
    "db:reset": "docker compose -f infrastructure/docker/docker-compose.dev.yml down -v && docker compose -f infrastructure/docker/docker-compose.dev.yml up -d postgres redis",
    "db:psql": "docker compose -f infrastructure/docker/docker-compose.dev.yml exec postgres psql -U postgres -d ptas168_dev",
    "dev:docker:up": "docker compose -f infrastructure/docker/docker-compose.dev.yml up -d",
    "dev:docker:down": "docker compose -f infrastructure/docker/docker-compose.dev.yml down",
    "dev:docker:logs": "docker compose -f infrastructure/docker/docker-compose.dev.yml logs -f",
    "dev:docker:build": "docker compose -f infrastructure/docker/docker-compose.dev.yml build",
    "dev:docker:install": "docker compose -f infrastructure/docker/docker-compose.dev.yml run --rm setup",
    "dev:docker:psql": "docker compose -f infrastructure/docker/docker-compose.dev.yml exec postgres psql -U postgres -d ptas168_dev",
    "dev:docker:reset": "docker compose -f infrastructure/docker/docker-compose.dev.yml down -v && docker compose -f infrastructure/docker/docker-compose.dev.yml up -d",
    "prod:build": "docker compose --env-file .env.production -f infrastructure/docker/docker-compose.production.yml build",
    "prod:up": "docker compose --env-file .env.production -f infrastructure/docker/docker-compose.production.yml up -d postgres redis backend worker telegram-bot frontend",
    "prod:down": "docker compose --env-file .env.production -f infrastructure/docker/docker-compose.production.yml down",
    "prod:logs": "docker compose --env-file .env.production -f infrastructure/docker/docker-compose.production.yml logs -f",
    "prod:restart": "docker compose --env-file .env.production -f infrastructure/docker/docker-compose.production.yml restart",
    "prod:migrate": "docker compose --env-file .env.production -f infrastructure/docker/docker-compose.production.yml run --rm migrate",
    "prod:seed": "docker compose --env-file .env.production -f infrastructure/docker/docker-compose.production.yml run --rm seed",
    "prod:psql": "docker compose --env-file .env.production -f infrastructure/docker/docker-compose.production.yml exec postgres psql -U postgres -d ptas168_prod",
    "db:generate": "pnpm --filter @ptas/db generate",
    "db:migrate": "pnpm --filter @ptas/db migrate",
    "db:deploy": "pnpm --filter @ptas/db deploy",
    "db:studio": "pnpm --filter @ptas/db studio",
    "db:seed": "pnpm --filter @ptas/db seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
