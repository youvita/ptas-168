# Vite loads this file automatically in dev (`vite dev` runs with mode=development).
# vite.config.ts calls loadEnv(mode, cwd, '') so unprefixed vars like BACKEND_URL
# are visible to the config; ONLY VITE_-prefixed vars are exposed to the browser bundle.

# Dev proxy target — Vite forwards /api/* to this origin (see vite.config.ts).
BACKEND_URL=http://localhost:3001

# Leave as the relative default so API calls flow through the Vite proxy above.
# (sdk.ts falls back to '/api' when this is unset; set an absolute URL only to bypass the proxy.)
VITE_API_URL=/api

# Where the dev backend serves uploaded files (disk-mode static dir on :3001).
VITE_FILE_URL=http://localhost:3001
